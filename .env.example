# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=speech_trainer
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/speech_trainer

# API auth/security
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API runtime
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/app/storage

# Worker / ASR
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_CACHE_DIR=/models/faster-whisper
HF_HOME=/models/huggingface
XDG_CACHE_HOME=/models/.cache
ASR_LOW_CONF_THRESHOLD=0.3

# Frontend (browser-side URL)
VITE_API_URL=http://localhost:8000

# Local LLM (llama.cpp server)
# IMPORTANT: llm service runs only with docker compose profile "llm".
# Start with: docker compose --profile llm up --build
LOCAL_LLM_ENABLED=1
LOCAL_LLM_BASE_URL=http://llm:8080
LOCAL_LLM_MODEL_PATH=/models/model.gguf
LOCAL_LLM_TIMEOUT_SEC=120
LOCAL_LLM_MAX_RETRIES=0
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_MAX_TOKENS=256
LOCAL_LLM_MAX_TOKENS_QUESTIONS=180
LOCAL_LLM_MAX_TOKENS_KEYMOMENTS=180
LOCAL_LLM_MAX_INPUT_CHARS=700
LOCAL_LLM_JSON_STRICT=1
LOCAL_LLM_MAX_PARALLEL_REQUESTS=1
DEBUG_LLM=0
DEBUG_LLM_QUALITY=0
LOCAL_LLM_PARALLEL=1
LOCAL_LLM_CTX_SIZE=2048
LOCAL_LLM_BATCH_SIZE=512
LOCAL_LLM_UBATCH_SIZE=256
LOCAL_LLM_N_GPU_LAYERS=24
LOCAL_LLM_THREADS=8
LOCAL_LLM_THREADS_BATCH=8

DEBUG_VISUAL=1
